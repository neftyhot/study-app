{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@megan/core/*": ["../packages/core/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"],
  "exclude": ["src/**/*.test.ts"]
}
