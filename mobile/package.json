{
  "name": "megan-study-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Megan Study for iPhone and iPad: the shared core (packages/core) in a Capacitor shell.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && cap sync ios",
    "open": "cap open ios",
    "ios": "npm run sync && cap run ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "lucide-react": "^1.47.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sql.js": "1.15.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "^5",
    "vite": "8.3.5"
  }
}
