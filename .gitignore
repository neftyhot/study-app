# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Study app
data/
*.db
*.db-wal
*.db-shm
.env.local
.env*.local
.env*.local

# Desktop build output
release/
.license-private-key.pem

# Licensing: the private key must never be committed or packaged
.license-private-key.pem

# Compiled main process (generated by scripts/compile-main.mjs)
electron/build/

# License manager: issued keys and revocations never leave this machine
licenses.json
revocations.json

# License Authority build output (admin tooling, never distributed)
dist-admin/
!electron/license/license-public-key.pem

# Licensing Worker: local secrets and wrangler state
workers/licensing/.dev.vars
workers/licensing/.wrangler/
workers/licensing/node_modules/
.env
