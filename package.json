{
  "name": "megan-study",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "fixtures": "tsx scripts/build-fixtures.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "grade:check": "tsx --env-file=.env.local scripts/grade-check.ts",
    "smoke": "tsx scripts/smoke.ts",
    "electron:dev": "concurrently -k -n next,electron -c cyan,magenta \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "next build && node scripts/prepare-standalone.mjs && npm run electron:compile && electron-builder",
    "electron:pack": "next build && node scripts/prepare-standalone.mjs && npm run electron:compile && electron-builder --dir",
    "build:win": "next build && node scripts/prepare-standalone.mjs --platform=win32 --arch=x64 && node scripts/compile-main.mjs --platform=win32 --arch=x64 && electron-builder --win --x64",
    "electron:compile": "node scripts/compile-main.mjs",
    "license-manager:dev": "electron tools/license-manager/main.js",
    "license-manager:build": "electron-builder --config tools/license-manager/electron-builder.yml --mac --arm64",
    "license-manager:selftest": "electron tools/license-manager/selftest.js",
    "tutor:check": "tsx --env-file=.env.local scripts/tutor-check.ts",
    "generate:bench": "tsx --env-file=.env.local scripts/generate-bench.ts",
    "coverage:bench": "tsx --env-file=.env.local scripts/coverage-bench.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@google/genai": "^2.23.0",
    "@napi-rs/canvas": "^1.0.9",
    "better-sqlite3": "^13.0.3",
    "bytenode": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "node-llama-cpp": "^3.21.1",
    "node-machine-id": "^1.1.12",
    "openai": "^7.20.0",
    "p-limit": "^7.3.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "docx": "^9.7.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.cjs",
  "description": "Generate sourced flashcards from your own lecture material.",
  "author": "Megan Study",
  "build": {
    "appId": "app.study.desktop",
    "productName": "Megan Study",
    "files": [
      "electron/build/**/*",
      ".next/standalone/**/*",
      "!**/node_modules/.bin/**",
      "!**/node_modules/electron/**",
      "!tools/**",
      "!licenses.json",
      "!revocations.json",
      "!.license-private-key.pem",
      "!**/.env",
      "!**/.env.*",
      "!**/*.test.*",
      "!**/__fixtures__/**",
      "!**/*.db",
      "!**/*.db-*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/build/main.cjs"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "MeganStudy",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Megan Study",
      "artifactName": "MeganStudy-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MeganStudy-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "npmRebuild": false,
    "asar": false
  }
}
